---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Check official CMS safety ratings, hospitalization rates, and quality scores for home health agencies and hospice care providers across the United States." } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="bg-slate-50 text-slate-900 min-h-screen flex flex-col font-sans">
    <!-- Header -->
    <header class="bg-slate-900 text-white shadow-md sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center space-x-2">
          <span class="text-xl font-extrabold tracking-tight text-red-500">HomeCare<span class="text-white">Violations</span>.com</span>
        </a>
        <div class="hidden md:flex items-center space-x-6 text-sm font-medium">
          <a href="/" class="hover:text-red-400 transition">Search Directory</a>
          <a href="/checklist" class="bg-amber-500 hover:bg-amber-400 text-slate-950 px-4 py-2 rounded-lg font-extrabold transition shadow">
            Get Safety Checklist (.99)
          </a>
        </div>
      </div>
    </header>

    <!-- Main Content -->
    <main class="flex-grow">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-slate-900 text-slate-400 py-12 mt-16 border-t border-slate-800">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 md:grid-cols-3 gap-8">
        <div>
          <span class="text-lg font-bold text-white">HomeCareViolations.com</span>
          <p class="mt-2 text-sm text-slate-400">
            Independent watchdog directory providing public CMS safety ratings, hospitalization tracking, and quality metrics for home health care agencies nationwide.
          </p>
        </div>
        <div>
          <h3 class="text-sm font-semibold text-white uppercase tracking-wider">Legal Disclaimer</h3>
          <p class="mt-2 text-xs text-slate-500">
            Data is sourced directly from Centers for Medicare & Medicaid Services (CMS) public datasets. This site is not affiliated with CMS or any government agency.
          </p>
        </div>
        <div>
          <h3 class="text-sm font-semibold text-white uppercase tracking-wider">Family Protection Guide</h3>
          <p class="mt-2 text-sm text-slate-300">Equip your family with our official transition checklist:</p>
          <a href="/checklist" class="mt-2 inline-block text-amber-400 font-bold hover:underline">Download PDF Guide (.99) &rarr;</a>
        </div>
      </div>
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-8 pt-8 border-t border-slate-800 text-center text-xs text-slate-500">
        &copy; 2026 HomeCareViolations.com. All rights reserved.
      </div>
    </footer>
  </body>
</html>
