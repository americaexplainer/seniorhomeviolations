---
interface Props {
  city: string;
  state: string;
}

const { city, state } = Astro.props;
---
<div class="sticky top-4 bg-gradient-to-br from-navy-500 to-navy-700 text-white rounded-xl p-6 shadow-xl">
  <h3 class="text-lg font-bold mb-2">Need Help Finding Safe Care?</h3>
  <p class="text-sm text-navy-100 mb-5">
    Our family advisors can help you find vetted, top-rated facilities in the {city} area at no cost.
  </p>
  <div class="space-y-3">
    <a
      href="#advisor-call"
      class="block w-full text-center bg-amber-400 hover:bg-amber-300 text-navy-900 font-semibold py-3 px-4 rounded-lg transition-colors text-sm"
    >
      Find Safe, Vetted Facilities Near {city}<br />
      <span class="text-xs font-normal">(Free Family Advisor Call)</span>
    </a>
    <a
      href="#checklist-pdf"
      class="block w-full text-center bg-white hover:bg-gray-100 text-navy-700 font-semibold py-3 px-4 rounded-lg transition-colors text-sm"
    >
      Download Inspection & Tour Checklist PDF<br />
      <span class="text-xs font-normal">3-Year Complete Report ($19)</span>
    </a>
  </div>
  <p class="text-[10px] text-navy-300 mt-4 text-center">
    Advisor service is free for families. We may receive referral compensation.
  </p>
</div>
